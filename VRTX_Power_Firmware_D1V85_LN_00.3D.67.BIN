_TRUE=0
_FALSE=1

# Interactive command line flags and boolean functions
_VAL_NO_TERMINAL=$_FALSE
_VAL_QUIET=$_FALSE
_DEP_WARNING=$_FALSE
_VAL_ALLOW_INSECURE_EXEC=$_FALSE
_VAL_FORCE=$_FALSE
_VAL_REBOOT=$_FALSE
