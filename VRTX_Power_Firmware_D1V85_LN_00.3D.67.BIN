}

# Check for ESXi System
# Determine if the application has been launched from an xterm or XWindows
[ -z "$TERM" ] && TERM=vt100
case $TERM in 
    # rxvt is a background terminal for Novell
    # nutc, ansi, vt100, screen are standard display terminals
    rxvt* | nutc* | ansi* | vt100* | screen*) # Do nothing
        ;;
    dumb* | linux*)
        [ -n "$DISPLAY" -a -n "$XAUTHORITY" ] && {
            which tty > /dev/null 2>&1
	    if [ $? = 0 ]; then
		tty --quiet || exec xterm +ls -e $0 $@ || $0 $@
	    fi
        }
        ;;
    # This will cause interactive DUPs to re-launch in an xterm window 
    # if stdin is not a terminal
    xterm*) 
	   which tty > /dev/null 2>&1
	   if [ $? = 0 ]; then
        	tty --quiet || _VAL_NO_TERMINAL=$_TRUE
	   fi
        ;;
    *) 
	which exec > /dev/null 2>&1
	if [ $? = 0 ]; then
		xec xterm +ls -e $0 $@
	fi
        ;;
esac

# Unset LD_PRELOAD to allow OS routines that use threading to work.
unset LD_PRELOAD

_CURRDIR=$PWD

# width for console text output formatting
_WIDTH=100

# Exit Codes
_EXECUTION_SUCCESS=0
_EXECUTION_UNSUCCESS=1
_SECURITY_ERROR=9

#Exit Code Messages
_EXECUTION_SUCCESS_MESSAGE="Exit Code = 0 (Success)"
_EXECUTION_UNSUCCESS_MESSAGE="Exit Code = 1 (Failure)"
_SECURITY_ERROR_MESSAGE="Exit Code = 9 (Failure)"
_MESSAGE_DESCRIPTION=""

#Function Defines the Map for Exit Code and Description
getMessage()	{
	_retCode=$1
	case $_retCode in
		$_EXECUTION_SUCCESS)
			_MESSAGE_DESCRIPTION=$_EXECUTION_SUCCESS_MESSAGE
			;;
		$_EXECUTION_UNSUCCESS)
			_MESSAGE_DESCRIPTION=$_EXECUTION_UNSUCCESS_MESSAGE
			;;
		$_SECURITY_ERROR)
			_MESSAGE_DESCRIPTION=$_SECURITY_ERROR_MESSAGE
			;;
		*)
			_MESSAGE_DESCRIPTION="Unknown Error"
			;;
	esac
}

#Variable to Recognize Sezgen System Logging
_SYSLOG_MSG=$_TRUE

# Embedded files and markers
_PACKAGE_GENERATOR="sezgen.sh"
_PACKAGE_NL="uni-eol.txt"
_MANIFEST_XML="package.xml"
_DUP_ARCHIVE="archive.tar.gz"
_MANIFEST_XML_MARKER="#####Startofpackage#####"
_DUP_ARCHIVE_MARKER="#####Startofarchive#####"

# Files and File prefixes
_TMPFILE_PREFIX=$(getTempFilePrefix)
