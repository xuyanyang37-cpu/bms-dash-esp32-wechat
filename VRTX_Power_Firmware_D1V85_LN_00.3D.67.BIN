# XML stylesheet transformer
_WIN_XSLTPROC="xsltproc.js"
which xsltproc > /dev/null 2>&1 && _TMP_XSLTPROC="$(which xsltproc)"
which cscript > /dev/null 2>&1  && _TMP_XSLTPROC="cscript /b $_WIN_XSLTPROC"
_XSLTPROC="$_TMP_XSLTPROC"
# Global modifiables
_PACKAGE_STATUS=0
_TEMP_PACKAGE_GENERATOR=""
_TEMP_MANIFEST_XML=""
_TEMP_ARCHIVE=""
_DUP_PACKAGE_NAME=""
_PAYLOAD_DIR=""

# Command line flags and boolean functions
_VAL_HELP=$_FALSE
_VAL_VERSION=$_FALSE
_VAL_LIST=$_FALSE
_VAL_LISTXML=$_FALSE
_VAL_EXTRACT=$_FALSE
_VAL_EXTRACT_DELL=$_FALSE
_VAL_DUP_PACKAGE_NAME=$_FALSE
_VAL_PAYLOAD_DIR=$_FALSE
bHelp() {
