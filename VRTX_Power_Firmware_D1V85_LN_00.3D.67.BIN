_MANIFEST_XSL="package.xsl"
_SPCONFIG_XSL="spconfig.xsl"
_PIECONFIG_XSL="PIEConfig.xsl"
_SPCONFIG_XML="spconfig.xml"
_PIECONFIG_XML="PIEConfig.xml"
